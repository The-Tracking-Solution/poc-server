DB_ENGINE=django.contrib.gis.db.backends.postgis
DJANGO_SECRET_KEY=VUL_EEN_LANGE_WILLEKEURIGE_WAARDE_IN
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,poc.example.nl
DJANGO_CSRF_TRUSTED_ORIGINS=https://poc.example.nl
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_SECURE_HSTS_SECONDS=3600
DJANGO_SESSION_COOKIE_SECURE=1
DJANGO_CSRF_COOKIE_SECURE=1
DJANGO_LOG_LEVEL=INFO
DB_NAME=poc_engine
DB_USER=poc_engine
DB_PASSWORD=VUL_EEN_STERK_WACHTWOORD_IN
DB_CONN_MAX_AGE=60
HTTP_PORT=80
POC_SWEEP_INTERVAL_SECONDS=1
POC_AUDIO_MAX_FRAME_BYTES=65536
FILE_UPLOAD_MAX_MEMORY_SIZE=10485760
DATA_UPLOAD_MAX_MEMORY_SIZE=10485760
BACKUP_RETENTION_DAYS=14

RADIO_PRIORITY_COUNTDOWN_SECONDS=5
RADIO_EMERGENCY_ACTIVATE_SECONDS=2

CHANNEL_LAYER_CAPACITY=5000
CHANNEL_LAYER_EXPIRY=60
CHANNEL_LAYER_GROUP_EXPIRY=86400

# Alleen gebruikt als de beheerder nog niet bestaat.
DJANGO_INITIAL_ADMIN_USERNAME=admin
DJANGO_INITIAL_ADMIN_PASSWORD=poc2026
DJANGO_INITIAL_ADMIN_EMAIL=admin@localhost

# WebRTC / LiveKit
LIVEKIT_API_KEY=replace_with_livekit_api_key
LIVEKIT_API_SECRET=replace_with_random_secret_at_least_32_chars
# Leeg = zelfde Apache-host. Apache proxyt /rtc naar LiveKit op 127.0.0.1:7880.
LIVEKIT_PUBLIC_URL=
LIVEKIT_SIGNAL_PORT=7880
LIVEKIT_TCP_PORT=7881
LIVEKIT_UDP_PORT=7882

# Apache proxyt Django/ASGI naar deze lokale hostpoort
APP_PORT=8003
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=0
DJANGO_SECURE_HSTS_PRELOAD=0

# Virtuele tijd-radio voor batterijtest
TEST_CLOCK_TENANT_SLUG=
TEST_CLOCK_TIMEZONE=Europe/Amsterdam
TEST_CLOCK_PIPER_MODEL=/opt/piper-voices/nl_NL-alex-medium.onnx
TEST_CLOCK_PIPER_VOLUME=0.88
TEST_CLOCK_PIPER_NOISE_SCALE=0.55
TEST_CLOCK_PIPER_NOISE_W_SCALE=0.65
TEST_CLOCK_SPEECH_WPM=155
TEST_CLOCK_BEEP_HZ=1000
TEST_CLOCK_BEEP_LEVEL=0.32
